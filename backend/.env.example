# Entorno: development | test | production
NODE_ENV=development
# Puerto de la API
PORT=3001
# Origen permitido por CORS (URL del frontend)
CORS_ORIGIN=http://localhost:3000
# Conexión a PostgreSQL. En desarrollo: `docker compose up -d` en la raíz del repositorio.
DATABASE_URL=postgresql://checkout:checkout@localhost:5433/checkout?schema=public

# Pasarela de pagos: URL base de su API (Sandbox) y llave pública del comercio.
# Nunca se suben al repositorio: complétalas en tu .env.
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_PUBLIC_KEY=
# Secreto de integridad: firma cada cobro. Solo backend, nunca en el frontend.
PAYMENT_GATEWAY_INTEGRITY_SECRET=
# Tiempo máximo de espera por petición a la pasarela (ms)
PAYMENT_GATEWAY_TIMEOUT_MS=10000

# Tarifas del checkout, en centavos (2.500 COP y 8.000 COP)
BASE_FEE_IN_CENTS=250000
DELIVERY_FEE_IN_CENTS=800000

# Espera del resultado de un cobro (ms): tiempo máximo y frecuencia de consulta
PAYMENT_GATEWAY_POLL_TIMEOUT_MS=10000
PAYMENT_GATEWAY_POLL_INTERVAL_MS=1000
